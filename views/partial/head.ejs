<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> - Suma-Tech ERP</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
body{background:#f5f5f5;}
.sidebar{width:230px;min-height:100vh;background:#1a1a2e;position:fixed;top:0;left:0;z-index:100;}
.sidebar .brand{padding:20px 16px 12px;border-bottom:1px solid rgba(255,255,255,.1);}
.sidebar .brand h5{color:#f0a500;font-weight:700;margin:0;}
.sidebar .brand small{color:#aaa;font-size:11px;}
.sidebar .nav-section{color:#888;font-size:10px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;padding:14px 16px 4px;}
.sidebar .nav-link{color:#ccc;padding:8px 16px;font-size:13.5px;border-radius:0;}
.sidebar .nav-link:hover,.sidebar .nav-link.active{background:rgba(240,165,0,.15);color:#f0a500;}
.sidebar .nav-link i{width:20px;}
.sidebar-footer{position:absolute;bottom:0;width:100%;padding:12px 16px;border-top:1px solid rgba(255,255,255,.1);}
.sidebar-footer .text-white{font-size:13px;}
.sidebar-footer small{font-size:11px;}
.main-content{margin-left:230px;padding:24px;}
.topbar{background:#fff;padding:14px 24px;margin:-24px -24px 24px;border-bottom:1px solid #e0e0e0;display:flex;align-items:center;justify-content:space-between;}
.topbar h4{margin:0;font-size:18px;font-weight:600;}
.card{border:none;box-shadow:0 1px 4px rgba(0,0,0,.08);border-radius:8px;}
.card-header{background:#fff;font-weight:600;font-size:14px;border-bottom:1px solid #f0f0f0;}
.table th{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:#666;background:#f8f8f8;}
.table td{font-size:13.5px;vertical-align:middle;}
.badge{font-weight:500;}
.btn-sm{font-size:12px;}
</style>
</head>
<body>
