<% if(success && success.length){ %><div class="alert alert-success alert-dismissible fade show py-2"><i class="bi bi-check-circle me-1"></i><%=success[0]%><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
<% if(error && error.length){ %><div class="alert alert-danger alert-dismissible fade show py-2"><i class="bi bi-exclamation-circle me-1"></i><%=error[0]%><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
