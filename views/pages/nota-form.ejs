<%- include('../partial/head') %><%- include('../partial/navbar',{page:'nota'}) %>
<div class="topbar"><div><h4>Form Nota Rekondisi Aktual (UC-14)</h4><small class="text-muted"><%= lb.UnitID %> — <%= lb.Merk %> <%= lb.Tipe %></small></div><a href="/nota" class="btn btn-outline-secondary btn-sm">← Kembali</a></div>
<%- include('../partial/flash') %>
<form method="POST" action="/nota">
<input type="hidden" name="UnitID" value="<%= lb.UnitID %>">
<input type="hidden" name="LogBookID" value="<%= lb.LogBookID %>">
<div class="card mb-3"><div class="card-header">Biaya Aktual Rekondisi</div><div class="card-body row g-2">
<div class="col-md-4"><label class="form-label fw-semibold">Biaya Pengadaan Aktual (Rp)</label><input type="number" name="BiayaPengadaanAktual" class="form-control" value="<%= lb.HargaBeli||0 %>" required oninput="hitung()"></div>
<div class="col-md-4"><label class="form-label fw-semibold">Biaya Rekondisi Aktual (Rp)</label><input type="number" name="BiayaRekondisiAktual" class="form-control" value="<%= lb.TotalBiayaTK||0 %>" required oninput="hitung()"></div>
<div class="col-md-4"><label class="form-label fw-semibold">Biaya Suku Cadang Aktual (Rp)</label><input type="number" name="BiayaSCaktual" class="form-control" value="<%= lb.TotalBiayaSC||0 %>" required oninput="hitung()"></div>
<div class="col-md-6 mt-2"><div class="alert alert-secondary py-2">Total HPP Aktual: <strong id="totalHPP">Rp 0</strong></div></div>
</div></div>
<div class="card mb-3"><div class="card-header">Harga Jual Final & Tagihan</div><div class="card-body row g-2">
<% if(req_unit){ %><div class="col-12"><div class="alert alert-info py-2 small">
<strong>Opsi Pembayaran Pelanggan: <%= req_unit.OpsiPembayaran||'Belum dipilih' %></strong><br>
<% if(req_unit.OpsiPembayaran==='sebagian'){ %>Pelanggan sudah bayar sebagian. Sistem akan menghitung sisa tagihan.<% } else if(req_unit.OpsiPembayaran==='penuh'){ %>Pelanggan akan bayar penuh di akhir.<% } %>
</div></div><% } %>
<div class="col-md-6"><label class="form-label fw-semibold">Harga Jual Final (Rp) <span class="text-danger">*</span></label><input type="number" name="HargaJualFinal" class="form-control" required placeholder="Masukkan harga jual final"></div>
</div></div>
<button class="btn btn-warning px-4">Kunci HPP & Terbitkan Nota</button>
</form>
<script>
function hitung(){
  const a=parseInt(document.querySelector('[name=BiayaPengadaanAktual]').value)||0;
  const b=parseInt(document.querySelector('[name=BiayaRekondisiAktual]').value)||0;
  const c=parseInt(document.querySelector('[name=BiayaSCaktual]').value)||0;
  document.getElementById('totalHPP').textContent='Rp '+(a+b+c).toLocaleString('id-ID');
}
hitung();
</script>
<%- include('../partial/foot') %>
