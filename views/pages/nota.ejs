<%- include('../partial/head') %><%- include('../partial/navbar',{page:'nota'}) %>
<div class="topbar"><h4>Nota Rekondisi Aktual (UC-14)</h4></div>
<%- include('../partial/flash') %>
<% if(unitSiap.length){ %>
<div class="card mb-3 border-warning"><div class="card-header text-warning">Unit Menunggu Validasi Finance (<%= unitSiap.length %>)</div><div class="card-body p-0"><table class="table table-sm mb-0"><thead><tr><th>Unit</th><th>LogBook</th><th>Biaya TK</th><th>Biaya SC</th><th>Aksi</th></tr></thead><tbody>
<% unitSiap.forEach(u=>{ %><tr><td><%= u.UnitID %> — <%= u.Merk %> <%= u.Tipe %></td><td><%= u.LogBookID %></td><td>Rp <%= Number(u.TotalBiayaTK||0).toLocaleString('id-ID') %></td><td>Rp <%= Number(u.TotalBiayaSC||0).toLocaleString('id-ID') %></td><td><a href="/nota/form/<%= u.LogBookID %>" class="btn btn-sm btn-warning">Terbitkan Nota</a></td></tr><% }) %>
</tbody></table></div></div>
<% } %>
<div class="card"><div class="card-header">Riwayat Nota Rekondisi Aktual</div><div class="card-body p-0"><table class="table table-hover mb-0"><thead><tr><th>No. Dokumen</th><th>Unit</th><th>Total HPP Aktual</th><th>Tagihan Final</th><th>Tanggal</th></tr></thead><tbody>
<% rows.forEach(r=>{ %><tr>
<td><%= r.NomorDokumen %></td>
<td><%= r.Merk %> <%= r.Tipe %><br><small class="text-muted"><%= r.UnitID %></small></td>
<td class="fw-bold">Rp <%= Number(r.TotalHPPAktual).toLocaleString('id-ID') %></td>
<td class="fw-bold text-warning">Rp <%= Number(r.TagihanFinal||r.TotalHPPAktual).toLocaleString('id-ID') %></td>
<td><small><%= new Date(r.TanggalTerbit).toLocaleDateString('id-ID') %></small></td>
</tr><% }) %>
<% if(!rows.length){ %><tr><td colspan="5" class="text-center text-muted p-4">Belum ada nota rekondisi aktual</td></tr><% } %>
</tbody></table></div></div>
<%- include('../partial/foot') %>
